    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Loscardos.TikTokPartnerSdk.Storage.EntityFramework</RootNamespace>
    <Description>Entity Framework Core token storage and token protection for TikTok Partner SDK.</Description>
