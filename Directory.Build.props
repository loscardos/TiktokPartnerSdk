<Project>
  <PropertyGroup>
    <Authors>Loscardos</Authors>
    <Company>Loscardos</Company>
    <Product>TikTok Partner SDK for .NET</Product>
    <PackageId>Loscardos.$(MSBuildProjectName)</PackageId>
    <Description>ASP.NET-friendly TikTok Shop Partner SDK for .NET.</Description>
    <PackageTags>tiktok;tiktok-shop;partner-sdk;ecommerce</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/loscardos/tiktokpartnersdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Version>0.1.0-preview</Version>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)docs/nuget-readme.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
